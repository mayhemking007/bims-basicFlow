// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ResponseType {
  MULTIPLE_CHOICE
  BINARY
  TEXT
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  createdAt DateTime @default(now())

  mindCard      MindCard?
  responses     UserResponse[]
  interestsFrom Interest[] @relation("InterestFrom")
}

model MindCard {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String
  intro     String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps     Step[]
  responses UserResponse[]
  interests Interest[]
}

model Step {
  id           String       @id @default(cuid())
  mindCardId   String
  order        Int
  text         String
  responseType ResponseType
  createdAt    DateTime     @default(now())

  mindCard     MindCard     @relation(fields: [mindCardId], references: [id], onDelete: Cascade)
  options      Option[]
  authorAnswer AuthorAnswer?
  responses    UserResponse[]

  @@unique([mindCardId, order])
  @@index([mindCardId])
}

model Option {
  id        String   @id @default(cuid())
  stepId    String
  text      String
  order     Int
  createdAt DateTime @default(now())

  step          Step           @relation(fields: [stepId], references: [id], onDelete: Cascade)
  authorAnswers AuthorAnswer[] @relation("AuthorOption")
  responses     UserResponse[]

  @@index([stepId])
}

model AuthorAnswer {
  id         String   @id @default(cuid())
  stepId     String   @unique
  optionId   String?
  textAnswer String?
  createdAt  DateTime @default(now())

  step   Step    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  option Option? @relation("AuthorOption", fields: [optionId], references: [id], onDelete: SetNull)
}

model UserResponse {
  id         String   @id @default(cuid())
  userId     String
  mindCardId String
  stepId     String
  optionId   String?
  textAnswer String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mindCard MindCard @relation(fields: [mindCardId], references: [id], onDelete: Cascade)
  step     Step     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  option   Option?  @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([userId, mindCardId, stepId])
  @@index([userId, mindCardId])
}

model Interest {
  id         String   @id @default(cuid())
  fromUserId String
  mindCardId String
  createdAt  DateTime @default(now())

  fromUser User     @relation("InterestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  mindCard MindCard @relation(fields: [mindCardId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, mindCardId])
  @@index([mindCardId])
}
